/* PhoneticFace — service worker (rede primeiro, cache como reserva offline) */
const CACHE = 'phoneticface-v4';
const ARQUIVOS = [
    './', './index.html', './style.css', './app.js', './manifest.json',
    './kaiologoteste.jpg', './imgem1.jpg', './imgem2.jpg', './imgem3.jpg'
];

self.addEventListener('install', (evento) => {
    self.skipWaiting();
    // add() individual: se uma imagem faltar, o resto continua sendo guardado
    evento.waitUntil(caches.open(CACHE).then((c) => Promise.allSettled(ARQUIVOS.map((a) => c.add(a)))));
});

self.addEventListener('activate', (evento) => {
    evento.waitUntil(
        caches.keys()
            .then((nomes) => Promise.all(nomes.filter((n) => n !== CACHE).map((n) => caches.delete(n))))
            .then(() => self.clients.claim())
    );
});

self.addEventListener('fetch', (evento) => {
    const req = evento.request;
    if (req.method !== 'GET' || new URL(req.url).origin !== self.location.origin) return;
    evento.respondWith(
        fetch(req)
            .then((resp) => {
                if (resp.ok) { const copia = resp.clone(); caches.open(CACHE).then((c) => c.put(req, copia)); }
                return resp;
            })
            .catch(() => caches.match(req))
    );
});
